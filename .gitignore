# ==========================================================================
#   Telegram Cloud — .gitignore
#   Файлы из блока «СЕКРЕТЫ» публиковать НЕЛЬЗЯ: это доступ к вашему
#   Telegram-аккаунту и личные данные хранилища.
#
#   ВАЖНО: комментарий в .gitignore пишется ТОЛЬКО отдельной строкой.
#   Текст после образца в той же строке git считает частью образца,
#   и правило молча не работает.
# ==========================================================================

# ---------------- СЕКРЕТЫ: доступ к аккаунту ----------------
config.ini
TelegramCloud.session
*.session
*.session-journal

# ---------------- Личные данные хранилища ----------------
settings.json
path.bd
tgdrive.db
*.db

# ---------------- Временное и локальное ----------------
Temp/
Saves/
*.log
Web.backup_pre_redesign/

# ---------------- Архив устаревших доков (локально) ----------------
docs/archive/

# ---------------- Служебное ----------------
__pycache__/
*.py[cod]
*.pyd
.venv/
venv/
env/
.idea/
.vscode/
Thumbs.db
desktop.ini
